# Server
PORT=4000

# Auth (einzelner Nutzer)
# Hash mit "npm run hash-password -- <deinPasswort>" erzeugen
APP_PASSWORD_HASH=
JWT_SECRET=change-me-to-a-long-random-string

# Kalender (iCloud CalDAV) - Etappe 2
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Ordnet iCloud-Kalendernamen den drei Bereichen zu (JSON, einzeilig).
# Nicht gelistete Kalender erscheinen als "allgemein".
# Beispiel: {"Corelegal":"corelegal","Evermont":"evermont","Nachhilfe":"nachhilfe"}
CALENDAR_AREA_MAP={}

# Mail IONOS (IMAP) - Etappe 3
IONOS_IMAP_HOST=
IONOS_IMAP_PORT=993
IONOS_IMAP_USER=
IONOS_IMAP_PASSWORD=
# Ordnet Absenderadressen (Domain oder vollständige Adresse) den drei
# Bereichen zu (JSON, einzeilig). Nicht zugeordnete Absender erscheinen
# als "allgemein".
# Beispiel: {"kanzlei-mustermann.de":"corelegal","evermont.de":"evermont"}
MAIL_AREA_RULES={}
