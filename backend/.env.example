# Server
PORT=4000

# Auth (einzelner Nutzer)
# Hash mit "npm run hash-password -- <deinPasswort>" erzeugen
APP_PASSWORD_HASH=
JWT_SECRET=change-me-to-a-long-random-string

# Kalender (iCloud CalDAV) - Etappe 2
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=

# Mail IONOS (IMAP) - Etappe 3
IONOS_IMAP_HOST=
IONOS_IMAP_PORT=993
IONOS_IMAP_USER=
IONOS_IMAP_PASSWORD=
